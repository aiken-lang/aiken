import AikenVerify.Utils
import PlutusCore.Integer
import PlutusCore.ByteString
import PlutusCore.UPLC.ScriptEncoding
import Blaster

namespace AikenVerify.Proofs.My_module.test_void
open PlutusCore.Integer (Integer)
open PlutusCore.ByteString (ByteString)
open PlutusCore.Integer (Integer)
open PlutusCore.UPLC.CekMachine
open PlutusCore.UPLC.Term (Term Const Program)
open AikenVerify.Utils

#import_uplc prog_my_module__test_void_96ab277d PlutusV3 single_cbor_hex "./cbor/my_module__test_void_96ab277d.cbor"
#import_uplc fuzzer_prog_my_module__test_void_96ab277d PlutusV3 single_cbor_hex "./cbor/my_module__test_void_96ab277d_fuzzer.cbor"

set_option maxRecDepth 16384

-- Manifest-driven mode and execution metadata.
private abbrev testReturnMode : ReturnMode := .void
private abbrev testMode : TestMode := .normal
private abbrev testDecodePolicy : DecodePolicy := .decodeErrorIsTestFailure
private abbrev testOutcome (args : List Term) : TestEvalOutcome :=
  RunProperty testReturnMode prog_my_module__test_void_96ab277d args

theorem test_void :
  ∀ (x : Integer),
  (0 <= x ∧ x <= 255)
  →
  PropertySucceeds testReturnMode (testOutcome (intArg x)) :=
  by blaster

end AikenVerify.Proofs.My_module.test_void
