---
source: crates/aiken-project/src/telemetry/verification.rs
expression: verification_json_schema()
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aiken verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "trust",
    "properties",
    "warnings",
    "errors",
    "success"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "z3",
        "revisions",
        "budget"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "z3": {
          "type": "string"
        },
        "revisions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "budget": {
          "type": "string"
        }
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "counterexample"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "verified",
              "falsified",
              "inconclusive",
              "not-checked",
              "missing"
            ]
          },
          "counterexample": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success": {
      "type": "boolean"
    }
  }
}
