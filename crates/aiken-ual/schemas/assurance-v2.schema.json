{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cips.cardano.org/cips/cipXXXX/schemas/assurance-v2.json",
  "title": "Plutus Blueprint Assurance Document",
  "type": "object",
  "required": [
    "$schema",
    "preamble",
    "blueprint",
    "properties"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://cips.cardano.org/cips/cipXXXX/schemas/assurance-v2.json"
    },
    "preamble": {
      "$ref": "#/$defs/preamble"
    },
    "blueprint": {
      "$ref": "#/$defs/blueprintReference"
    },
    "languages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/registryEntry"
      }
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/registryEntry"
      }
    },
    "formalFragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formalFragment"
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/property"
      },
      "minItems": 1
    },
    "checkingContexts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "functions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/function"
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://cips.cardano.org/cips/cip57/extensions/compiled-interface/v1/value-schema.json"
      }
    }
  },
  "$defs": {
    "preamble": {
      "type": "object",
      "required": [
        "title",
        "authors",
        "created"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "blueprintReference": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "registryEntry": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "formalFragment": {
      "type": "object",
      "description": "Reusable formal-language definitions that formal statements are written against. Opaque text in the declared language; consumers that do not know the language ignore it.",
      "required": [
        "id",
        "language",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Unique within the document. Wider than a property id: fragment ids are typically source-language module names, so '.' is permitted."
        },
        "language": {
          "type": "string"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "description": "Ids of other fragments of the same document. The edges must be acyclic; the schema cannot express that."
        },
        "source": {
          "type": "string"
        }
      }
    },
    "property": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "properties": {
            "validators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "functions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "validators"
              ]
            },
            {
              "required": [
                "functions"
              ]
            }
          ],
          "additionalProperties": false
        },
        "statement": {
          "$ref": "#/$defs/statement"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRecord"
          }
        },
        "checkingContext": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "checkingContext"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "if": {
                    "required": [
                      "method"
                    ],
                    "properties": {
                      "method": {
                        "enum": [
                          "formal-proof",
                          "smt-check",
                          "property-test",
                          "unit-test"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "checkingContextHash"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "required": [
                  "functions"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "if": {
                    "properties": {
                      "method": {
                        "enum": [
                          "formal-proof",
                          "smt-check",
                          "property-test",
                          "unit-test"
                        ]
                      }
                    },
                    "required": [
                      "method"
                    ]
                  },
                  "then": {
                    "required": [
                      "functionHashes"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "required": [
                  "validators"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {
                  "if": {
                    "properties": {
                      "method": {
                        "enum": [
                          "formal-proof",
                          "smt-check",
                          "property-test",
                          "unit-test"
                        ]
                      }
                    },
                    "required": [
                      "method"
                    ]
                  },
                  "then": {
                    "required": [
                      "scriptHash"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "statement": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "formal": {
          "type": "object",
          "required": [
            "language"
          ],
          "properties": {
            "language": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "uses": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "description": "Ids of formalFragments this statement is written against. Must resolve within the document; the schema cannot express that."
            }
          },
          "anyOf": [
            {
              "required": [
                "source"
              ]
            },
            {
              "required": [
                "uri"
              ]
            }
          ]
        }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "required": [
        "method",
        "verifier",
        "outcome",
        "date"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "verifier": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "verified",
            "falsified",
            "partial",
            "inconclusive"
          ]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "scriptHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{56}$",
          "description": "Blake2b-224 hash digest of the script the verification ran against; for parameterized validators, the hash of the unapplied template."
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "notes": {
          "type": "string"
        },
        "checkingContextHash": {
          "$ref": "#/$defs/digest"
        },
        "functionHashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        }
      },
      "if": {
        "properties": {
          "method": {
            "enum": [
              "formal-proof",
              "smt-check",
              "property-test",
              "unit-test"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "tool",
          "artifact"
        ],
        "anyOf": [
          {
            "required": [
              "scriptHash"
            ]
          },
          {
            "required": [
              "functionHashes"
            ]
          }
        ]
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "uri",
        "hash"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "type": "string"
        }
      }
    },
    "digest": {
      "type": "object",
      "description": "A content digest: hash algorithm plus lowercase hex-encoded digest value.",
      "required": [
        "alg",
        "digest"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "function": {
      "type": "object",
      "required": [
        "compiledCode",
        "serialization",
        "hash",
        "plutusVersion",
        "arguments",
        "result"
      ],
      "properties": {
        "compiledCode": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "serialization": {
          "const": "cbor-flat"
        },
        "hash": {
          "$ref": "#/$defs/digest"
        },
        "plutusVersion": {
          "enum": [
            "v1",
            "v2",
            "v3"
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "https://cips.cardano.org/cips/cip57/extensions/compiled-interface/v1/value-schema.json"
          }
        },
        "result": {
          "$ref": "https://cips.cardano.org/cips/cip57/extensions/compiled-interface/v1/value-schema.json"
        }
      },
      "additionalProperties": false
    }
  }
}
