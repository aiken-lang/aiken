{
  "type": "object",
  "properties": {
    "dataType": {
      "enum": [
        "integer",
        "bytes",
        "list",
        "map",
        "constructor",
        "#unit",
        "#boolean",
        "#integer",
        "#bytes",
        "#string",
        "#list",
        "#pair",
        "#scott"
      ]
    },
    "$ref": {
      "type": "string",
      "pattern": "^#/definitions/.+"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "items": {
      "anyOf": [
        {
          "$ref": "#"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      ]
    },
    "keys": {
      "$ref": "#"
    },
    "values": {
      "$ref": "#"
    },
    "left": {
      "$ref": "#"
    },
    "right": {
      "$ref": "#"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "encoding": {
      "type": "string",
      "minLength": 1
    },
    "constructors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#"
            }
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "oneOf": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#"
      }
    },
    "anyOf": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#"
      }
    },
    "allOf": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#"
      }
    },
    "not": {
      "$ref": "#"
    },
    "minLength": {
      "type": "integer",
      "minimum": 0
    },
    "maxLength": {
      "type": "integer",
      "minimum": 0
    },
    "minItems": {
      "type": "integer",
      "minimum": 0
    },
    "maxItems": {
      "type": "integer",
      "minimum": 0
    },
    "minimum": {
      "type": "integer"
    },
    "maximum": {
      "type": "integer"
    },
    "exclusiveMinimum": {
      "type": "integer"
    },
    "exclusiveMaximum": {
      "type": "integer"
    },
    "multipleOf": {
      "type": "integer",
      "minimum": 1
    },
    "uniqueItems": {
      "type": "boolean"
    },
    "enum": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9a-fA-F]{2})*$"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cips.cardano.org/cips/cip57/extensions/compiled-interface/v1/value-schema.json",
  "title": "Draft compiled-interface value schema",
  "$comment": "Structural meta-schema; reference resolution, representation consistency, CIP-57 constraints and encoding support require semantic checks.",
  "allOf": [
    {
      "if": {
        "required": [
          "dataType"
        ],
        "properties": {
          "dataType": {
            "const": "#scott"
          }
        }
      },
      "then": {
        "required": [
          "encoding",
          "constructors"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "encoding"
              ]
            },
            {
              "required": [
                "constructors"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "dataType"
        ],
        "properties": {
          "dataType": {
            "enum": [
              "list",
              "#list"
            ]
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      }
    },
    {
      "if": {
        "required": [
          "dataType"
        ],
        "properties": {
          "dataType": {
            "const": "map"
          }
        }
      },
      "then": {
        "required": [
          "keys",
          "values"
        ]
      }
    },
    {
      "if": {
        "required": [
          "dataType"
        ],
        "properties": {
          "dataType": {
            "const": "constructor"
          }
        }
      },
      "then": {
        "required": [
          "index",
          "fields"
        ]
      }
    },
    {
      "if": {
        "required": [
          "dataType"
        ],
        "properties": {
          "dataType": {
            "const": "#pair"
          }
        }
      },
      "then": {
        "required": [
          "left",
          "right"
        ]
      }
    },
    {
      "if": {
        "required": [
          "$ref"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "dataType"
              ]
            },
            {
              "required": [
                "encoding"
              ]
            },
            {
              "required": [
                "constructors"
              ]
            }
          ]
        }
      }
    }
  ]
}
