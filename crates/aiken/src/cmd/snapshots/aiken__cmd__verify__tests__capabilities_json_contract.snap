---
source: crates/aiken/src/cmd/verify.rs
expression: "&caps"
---
{
  "version": "4",
  "supported_test_kinds": [
    "property"
  ],
  "unsupported_test_kinds": [
    {
      "kind": "unit",
      "status": "intentional",
      "reason": "Unit tests have no fuzzer input domain; formal verification requires universally quantified properties."
    },
    {
      "kind": "benchmark",
      "status": "intentional",
      "reason": "Benchmarks measure performance, not correctness; they have no boolean property to verify."
    }
  ],
  "target_modes": [
    "property",
    "validator (requires validator metadata)",
    "equivalence (requires validator metadata)"
  ],
  "supported_fuzzer_types": [
    "Int",
    "Bool",
    "ByteArray",
    "String",
    "Data",
    "List<T>",
    "Tuple(T, ...)",
    "Pair(T, T)",
    "Finite literal String domains (Exact/OneOf)",
    "Bounded top-level List<Bool> domains within finite enumeration cap",
    "Bounded scalar ByteArray length ranges",
    "Finite nullary ADT constructor domains (Data.Constr tag [])"
  ],
  "unsupported_fuzzer_types": [
    "Blaster translation gaps for some generated Lean predicates (e.g. List.Mem)",
    "Test arity > 1 is not supported directly; multi-input properties must be tuple/record encoded.",
    "General higher-order/partial-application fuzzer resolver coverage is incomplete; unresolved shapes require extractor improvements.",
    "Unbounded String/ByteArray content and finite literal ByteArray domains remain unsupported."
  ],
  "existential_modes": [
    "witness",
    "proof"
  ],
  "solver_profiles": [
    "finite",
    "symbolic",
    "symbolic-heavy",
    "sampler",
    "witness",
    "scenario-bmc",
    "scenario-kind",
    "strict-cert"
  ],
  "trust_profiles": [
    "strict",
    "production",
    "experimental",
    "unsafe-dev"
  ],
  "backends": {
    "blaster": {
      "available": true,
      "note": "Available via the generated Lake workspace; the verifier fetches Lean-blaster as a dependency rather than invoking a separate Blaster binary."
    },
    "solver_backend": {
      "available": true,
      "note": "Requires Z3 >= 4.8.0 on PATH at proof time."
    },
    "plutus_core_blaster": {
      "available": true,
      "note": "Available through the configured PlutusCoreBlaster dependency (local checkout or pinned git revision)."
    },
    "cardano_ledger_api_blaster": {
      "available": false,
      "note": "CardanoLedgerApiBlaster is not yet integrated into the current verification/scenario pipeline."
    }
  },
  "certification": {
    "solver_validated": {
      "available": true,
      "note": "Blaster/Z3-valid results are reported as SolverValidated when proof reconstruction is unavailable."
    },
    "lean_certified": {
      "available": false,
      "note": "LeanCertified reporting is reserved for kernel-checked proof reconstruction, which the current pipeline does not emit."
    },
    "proof_reconstruction": {
      "available": false,
      "note": "Proof reconstruction from Blaster/Z3 into Lean kernel-checked certificates is not wired through yet."
    },
    "strict_cert_profile": {
      "available": false,
      "note": "The strict-cert solver profile currently rejects SolverValidated results because Lean proof reconstruction support is unavailable."
    }
  },
  "max_test_arity": 1,
  "supported": [
    "property"
  ],
  "unsupported": [
    {
      "code": "E0011",
      "feature": "unbounded_bytearray",
      "skippable": true
    },
